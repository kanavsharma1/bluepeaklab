# Copy to .env.local (and add the same values in Vercel → Project → Settings → Environment Variables)

# Your WhatsApp number in international format, digits only (e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Optional: Google Search Console HTML-tag verification code (the content="" value only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
